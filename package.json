{
  "name": "itqan-forms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-folders.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "management:preview": "FORMS_DATA_DIR=\"$PWD/management-data\" php -d upload_max_filesize=20M -d post_max_size=24M -S 127.0.0.1:8181 -t dist scripts/management-router.php",
    "test:management": "node scripts/admin-handoff-audit.mjs",
    "test:workflow": "QA_OUT=tmp/client-corrections-pdfs node scripts/current-pdf-audit.mjs && PDF_AUDIT_OUTPUT=tmp/client-corrections-pdfs node scripts/direct-intake-audit.mjs",
    "test:reviews": "node scripts/review-navigation-audit.mjs && node scripts/optional-review-audit.mjs && node scripts/optional-review-actions-audit.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  }
}
