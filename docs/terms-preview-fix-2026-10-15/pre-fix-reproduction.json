    "cause": "sharedProfileChanged invalidates generation and destroys the active PDF during a documentOnly step, but only refreshes visible answers/progress and does not restart document loading",
    "source_locations": [
      "src/main.js:95 sharedProfileChanged",
      "src/main.js:290 showDocumentPages",
      "src/main.js:323 paint",
